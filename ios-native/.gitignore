# Xcode — user/build state
DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/
xcuserdata/
*.xcodeproj/xcuserdata/
project.xcworkspace/xcuserdata/
!default.xcworkspace/xcuserdata/
!*.xcodeproj/xcuserdata/
!*.xcworkspace/xcuserdata/
build/
Build/

# Xcode generated artifacts
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
*.dSYM/*
*.xcarchive
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# Swift Package Manager
.packages/
.swiftpm/
.build/
Package.resolved

# CocoaPods (if added later)
Pods/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Editors / IDE
.vscode/
.idea/
*.swp
*~

# Env / secrets (never commit)
.env
.env.*
*.local
config/secrets.swift
config/Config.xcconfig

# Agent / orchestrator runtime state
# (kept OUT of git — these are working state, not source)
.antigravitycli/
.claude/
.gemini/
.gstack/
.ruff_cache/
.maestro/

# Build tool artifacts
.cache/
.cache/*
.cache/projects.json

# Test outputs
*.xcresult/

# Logs
*.log
logs/

# Xcode may create a sibling .xcodeproj when opening the project dir
# (Xcode calls it "<dirname> 2.xcodeproj" if the dir name has a space).
# The canonical project is the xcodegen-generated one without a space.
Hydrolyze 2.xcodeproj/
