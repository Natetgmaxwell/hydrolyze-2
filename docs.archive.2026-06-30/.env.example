# Example env file. Copy to .env.local in the relevant subproject and fill in.
# DO NOT commit real values — only this template.

# hydrolyze-mobile/.env.local
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co/
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# The anon key is safe to expose to the client (Supabase design). The
# service_role key is NOT — never commit it, never ship it in the app.
