
-- Fix: add missing coaches INSERT + UPDATE policies
-- The trigger creates coaches on signup, but if that fails the app tries
-- to insert manually. A coach can only insert/update their own record.
CREATE POLICY "coaches_insert" ON coaches
  FOR INSERT WITH CHECK (auth.uid() = auth_id);

CREATE POLICY "coaches_update" ON coaches
  FOR UPDATE USING (auth.uid() = auth_id);

-- Also grant membership role access to coaches table
-- (needed so the authenticated role can access coaches via RLS)
GRANT USAGE ON SCHEMA public TO authenticated, anon;
GRANT ALL ON coaches TO authenticated, anon;
GRANT USAGE, SELECT ON SEQUENCE coaches_id_seq TO authenticated, anon;
