{
  "name": "hydrolyze-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest"
  },
  "jest": {
    "projects": [
      {
        "displayName": "node",
        "testEnvironment": "node",
        "testMatch": [
          "**/__tests__/ml-pairing.test.ts",
          "**/__tests__/pairing-v2.test.ts",
          "**/__tests__/speed-curve.test.ts",
          "**/__tests__/set-parser.test.ts",
          "**/__tests__/workout-parser.test.ts",
          "**/__tests__/workout-parser-v2.test.ts"
        ],
        "transform": {
          "\\.[jt]sx?$": [
            "babel-jest",
            {
              "caller": {
                "name": "jest-node"
              }
            }
          ]
        },
        "transformIgnorePatterns": [
          "/node_modules/"
        ]
      },
      {
        "displayName": "node-tsx",
        "testEnvironment": "node",
        "testMatch": [
          "**/__tests__/SessionContext.test.ts",
          "**/__tests__/WorkoutContext.test.ts"
        ],
        "transform": {
          "\\.[jt]sx?$": [
            "babel-jest",
            {
              "caller": {
                "name": "jest-node"
              }
            }
          ]
        },
        "transformIgnorePatterns": [
          "/node_modules/(?!(@react-native-async-storage)/)"
        ],
        "moduleNameMapper": {
          "@react-native-async-storage/async-storage": "@react-native-async-storage/async-storage/jest/async-storage-mock"
        }
      },
      {
        "displayName": "native",
        "preset": "jest-expo",
        "testMatch": [
          "**/__tests__/timing.test.tsx",
          "**/__tests__/*.test.tsx"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "ml-pairing\\.test\\.ts",
          "SessionContext\\.test\\.ts"
        ],
        "moduleNameMapper": {
          "@react-native-async-storage/async-storage": "@react-native-async-storage/async-storage/jest/async-storage-mock",
          "^expo-router$": "<rootDir>/__mocks__/expo-router.ts",
          "^react-native-gesture-handler$": "<rootDir>/__mocks__/react-native-gesture-handler.tsx"
        }
      }
    ]
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@supabase/supabase-js": "^2.104.0",
    "babel-preset-expo": "^55.0.18",
    "expo": "~54.0.33",
    "expo-apple-authentication": "^55.0.13",
    "expo-application": "~7.0.8",
    "expo-auth-session": "~7.0.10",
    "expo-crypto": "~15.0.8",
    "expo-font": "~14.0.11",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "^55.0.14",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-volume-manager": "^2.0.8",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@supabase/cli": "^1.0.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.16",
    "jest-snapshot": "^29.7.0",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
